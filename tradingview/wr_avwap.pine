// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// War Room AVWAP — anchored VWAPs after Brian Shannon, using the War Room lab's rules (vwap-handoff),
// plus the positive-skew pipeline's AVWAP and the session VWAP.
//
// Lines
//   High anchor  : last bar whose high beat every high of the prior 252 bars
//   Low anchor   : last bar whose low undercut every low of the prior 63 bars
//   Event anchor : last open ≥ 4% over the prior close on ≥ 2.5× the 50-bar volume with an up close; live 63 bars
//   Pipeline     : the more recent of the N-bar closing high / closing low (N = 21/63/126/252) — the feature
//                  avwap_dist_N in the positive-skew pipeline
//   Session VWAP : intraday charts only
// Setups (long; stop = line − 0.5 ATR): Reclaim, Pullback to the low's line, Pullback to the event line, Pinch.
// Bar price = hlc3 (TradingView daily bars carry no VWAP). Designed for daily charts.
//@version=6
indicator("War Room AVWAP", shorttitle = "WR AVWAP", overlay = true, max_bars_back = 500, max_labels_count = 500)

// ───────────────────────────────────────────────────────── inputs
grpA = "Anchors (War Room lab rules)"
hiLB = input.int(252, "High anchor: new high vs prior N bars", minval = 20, group = grpA)
loLB = input.int(63, "Low anchor: new low vs prior N bars", minval = 10, group = grpA)
evGap = input.float(4.0, "Event anchor: gap-up % ≥", group = grpA)
evVolX = input.float(2.5, "Event anchor: volume × 50-bar average ≥", group = grpA)
evLife = input.int(63, "Event anchor: live for N bars", group = grpA)

grpP = "Pipeline AVWAP"
showPipe = input.bool(true, "Show pipeline AVWAP (more recent N-bar closing extreme)", group = grpP)
pipeN = input.int(63, "N", options = [21, 63, 126, 252], group = grpP)

grpS = "Session VWAP"
showSess = input.bool(true, "Session VWAP (intraday charts)", group = grpS)

grpX = "Setups"
showSetups = input.bool(true, "Mark setups", group = grpX)
reclaimAge = input.int(20, "Reclaim: high anchor at least N bars old", group = grpX)
loAgeMin = input.int(10, "Pullback: low anchor at least N bars old", group = grpX)
touchATR = input.float(0.25, "Pullback: low within N × ATR of the line", group = grpX)
holdMaxATR = input.float(1.5, "Pullback: close no more than N × ATR above the line", group = grpX)
pinchATR = input.float(1.0, "Pinch: lines within N × ATR", group = grpX)
stopATR = input.float(0.5, "Stop: line − N × ATR", group = grpX)
showTable = input.bool(true, "State table", group = grpX)

colHi = input.color(#e0703a, "High-anchor line", group = "Colours")
colLo = input.color(#3b8fd9, "Low-anchor line", group = "Colours")
colEv = input.color(#8b74e8, "Event line", group = "Colours")
colPipe = input.color(color.new(#aab4c3, 20), "Pipeline line", group = "Colours")
colSess = input.color(#e8c547, "Session VWAP", group = "Colours")

// ───────────────────────────────────────────────────────── common
src = hlc3
atr14 = ta.atr(14)
pv = src * volume

// ───────────────────────────────────────────────────────── high anchor
newHi = high > ta.highest(high, hiLB)[1]
var float hiPV = na
var float hiV = na
var int hiBar = na
if newHi
    hiPV := pv
    hiV := volume
    hiBar := bar_index
else if not na(hiV)
    hiPV += pv
    hiV += volume
avwHi = not na(hiV) and hiV > 0 ? hiPV / hiV : na
hiAge = na(hiBar) ? na : bar_index - hiBar

// ───────────────────────────────────────────────────────── low anchor
newLo = low < ta.lowest(low, loLB)[1]
var float loPV = na
var float loV = na
var int loBar = na
if newLo
    loPV := pv
    loV := volume
    loBar := bar_index
else if not na(loV)
    loPV += pv
    loV += volume
avwLo = not na(loV) and loV > 0 ? loPV / loV : na
loAge = na(loBar) ? na : bar_index - loBar

// ───────────────────────────────────────────────────────── event anchor (gap on volume)
vol50 = ta.sma(volume, 50)[1]
gapPct = (open / close[1] - 1) * 100
isEvent = gapPct >= evGap and volume >= evVolX * vol50 and close > open
var float evPV = na
var float evV = na
var int evBar = na
var float evLow = na
if isEvent
    evPV := pv
    evV := volume
    evBar := bar_index
    evLow := low
else if not na(evV)
    evPV += pv
    evV += volume
evAge = na(evBar) ? na : bar_index - evBar
evLive = not na(evAge) and evAge <= evLife
avwEv = evLive and evV > 0 ? evPV / evV : na

// ───────────────────────────────────────────────────────── pipeline AVWAP (more recent closing extreme)
hb = ta.highestbars(close, pipeN)
lb = ta.lowestbars(close, pipeN)
float avwPipe = na
if showPipe and bar_index >= pipeN and not na(hb) and not na(lb)
    k = -math.max(hb, lb)
    float sPV = 0.0
    float sV = 0.0
    for i = 0 to k
        sPV += src[i] * volume[i]
        sV += volume[i]
    avwPipe := sV > 0 ? sPV / sV : na

// ───────────────────────────────────────────────────────── session VWAP
sessV = ta.vwap(hlc3)

// ───────────────────────────────────────────────────────── plots (break the line where it re-anchors)
plot(newHi ? na : avwHi, "AVWAP from the high", colHi, 2, plot.style_linebr)
plot(newLo ? na : avwLo, "AVWAP from the low", colLo, 2, plot.style_linebr)
plot(isEvent ? na : avwEv, "AVWAP from the event", colEv, 2, plot.style_linebr)
plot(showPipe ? avwPipe : na, "Pipeline AVWAP", colPipe, 1, plot.style_linebr)
plot(showSess and timeframe.isintraday ? sessV : na, "Session VWAP", colSess, 1)
plotshape(newHi, "High anchor", shape.circle, location.abovebar, colHi, size = size.tiny)
plotshape(newLo, "Low anchor", shape.circle, location.belowbar, colLo, size = size.tiny)
plotshape(isEvent, "Event anchor", shape.diamond, location.belowbar, colEv, size = size.tiny)

// ───────────────────────────────────────────────────────── setups
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
hi252 = ta.highest(high, 252)
clv = high > low ? (close - low) / (high - low) : 0.5

reclaim = not newHi and not na(avwHi) and close > avwHi and close[1] <= avwHi[1] and hiAge >= reclaimAge and close > sma50

pullLo = not na(avwLo) and loAge >= loAgeMin and low <= avwLo + touchATR * atr14 and close > avwLo and clv >= 0.5 and close - avwLo <= holdMaxATR * atr14 and sma50 > sma50[5] and close > sma200 and close >= 0.75 * hi252

pullEv = not na(avwEv) and evAge >= 3 and low <= avwEv + touchATR * atr14 and close > avwEv and close > evLow and clv >= 0.5

upper = math.max(avwHi, avwLo)
pinch = not na(avwHi) and not na(avwLo) and hiBar < loBar and math.abs(avwHi - avwLo) <= pinchATR * atr14 and close > upper and close[1] <= upper[1]

mk(bool cond, string txt, float lvl, string name) =>
    if showSetups and cond and not na(lvl)
        stop = lvl - stopATR * atr14
        label.new(bar_index, low, txt, style = label.style_label_up, color = color.new(#3fbf7f, 0), textcolor = color.white, size = size.tiny, tooltip = name + "\nbuy stop over today's high: " + str.tostring(high, format.mintick) + "\nstop: " + str.tostring(stop, format.mintick) + "\nrisk: " + str.tostring((high - stop) / high * 100, "0.0") + "%")

mk(reclaim, "R", avwHi, "Reclaim of the AVWAP from the high")
mk(pullLo, "P", avwLo, "Pullback to the AVWAP from the low")
mk(pullEv, "E", avwEv, "Pullback to the event AVWAP")
mk(pinch, "X", math.min(avwHi, avwLo), "Pinch: lines converged, first close over both")

alertcondition(reclaim, "WR AVWAP: reclaim", "{{ticker}}: reclaim of the AVWAP from the high")
alertcondition(pullLo, "WR AVWAP: pullback to low line", "{{ticker}}: pullback to the AVWAP from the low")
alertcondition(pullEv, "WR AVWAP: pullback to event line", "{{ticker}}: pullback to the event AVWAP")
alertcondition(pinch, "WR AVWAP: pinch", "{{ticker}}: AVWAP pinch breakout")

// ───────────────────────────────────────────────────────── state table
pct(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "0.0") + "%"
dist(float lvl) => na(lvl) ? "—" : pct((close / lvl - 1) * 100)
state = na(avwHi) or na(avwLo) ? "—" : close > avwHi and close > avwLo ? "ABOVE BOTH" : close < avwHi and close < avwLo ? "BELOW BOTH" : "BETWEEN"
stateCol = state == "ABOVE BOTH" ? #3fbf7f : state == "BELOW BOTH" ? #e5534b : #e8c547

var table t = table.new(position.top_right, 3, 6, bgcolor = color.new(#121722, 10), border_color = color.new(#232b3b, 0), border_width = 1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "AVWAP state", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, state, text_color = stateCol, text_size = size.small)
    table.cell(t, 2, 0, "age", text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 1, "from high", text_color = colHi, text_size = size.small)
    table.cell(t, 1, 1, dist(avwHi), text_color = color.white, text_size = size.small)
    table.cell(t, 2, 1, na(hiAge) ? "—" : str.tostring(hiAge), text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 2, "from low", text_color = colLo, text_size = size.small)
    table.cell(t, 1, 2, dist(avwLo), text_color = color.white, text_size = size.small)
    table.cell(t, 2, 2, na(loAge) ? "—" : str.tostring(loAge), text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 3, "event", text_color = colEv, text_size = size.small)
    table.cell(t, 1, 3, dist(avwEv), text_color = color.white, text_size = size.small)
    table.cell(t, 2, 3, evLive ? str.tostring(evAge) : "—", text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 4, "pipeline " + str.tostring(pipeN), text_color = colPipe, text_size = size.small)
    table.cell(t, 1, 4, dist(avwPipe), text_color = color.white, text_size = size.small)
    table.cell(t, 2, 4, "", text_size = size.small)
    table.cell(t, 0, 5, "pinch (ATR)", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 5, na(avwHi) or na(avwLo) ? "—" : str.tostring(math.abs(avwHi - avwLo) / atr14, "#.00"), text_color = color.white, text_size = size.small)
    table.cell(t, 2, 5, "", text_size = size.small)
