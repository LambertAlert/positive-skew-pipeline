{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Positive-skew dashboard (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "psp_dashboard.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Pipeline: full run on Massive",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_massive.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
